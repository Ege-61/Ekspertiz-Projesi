<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMevcutPaketAdi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="Premium Tam Paket"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnPaketDuzenle"/>

        <TextView
            android:id="@+id/tvMevcutPaketIcerik"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:text="Motor, Kaporta, OBD, Airbag"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMevcutPaketAdi"
            app:layout_constraintEnd_toStartOf="@+id/btnPaketDuzenle"/>

        <TextView
            android:id="@+id/tvMevcutPaketFiyat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="3.500,00 ₺"
            android:textColor="@color/ana_yesil"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMevcutPaketIcerik"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnPaketDuzenle"
            android:layout_width="92dp"
            android:layout_height="36dp"
            android:text="DÜZENLE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:backgroundTint="#42A5F5"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnPaketSil"
            android:layout_width="92dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:text="SİL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:backgroundTint="#EF5350"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnPaketDuzenle"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>