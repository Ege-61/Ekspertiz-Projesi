<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/ana_yesil"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yeni Rapor Oluştur"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvPaketBilgi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yükleniyor..."
                android:textColor="@color/ana_yesil"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/etRaporPlaka"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Plaka"
                android:enabled="false"
                android:background="@drawable/bg_modern_kutu"
                android:paddingHorizontal="15dp"
                android:layout_marginBottom="10dp"/>
            <EditText
                android:id="@+id/etRaporMarka"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Marka"
                android:enabled="false"
                android:background="@drawable/bg_modern_kutu"
                android:paddingHorizontal="15dp"
                android:layout_marginBottom="10dp"/>
            <EditText
                android:id="@+id/etRaporModel"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Model"
                android:enabled="false"
                android:background="@drawable/bg_modern_kutu"
                android:paddingHorizontal="15dp"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etRaporSase"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Şase Numarası (17 Hane)"
                android:maxLength="17"
                android:background="@drawable/bg_modern_kutu"
                android:paddingHorizontal="15dp"
                android:layout_marginBottom="10dp"/>
            <EditText
                android:id="@+id/etRaporKilometre"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Güncel Kilometre"
                android:inputType="number"
                android:background="@drawable/bg_modern_kutu"
                android:paddingHorizontal="15dp"
                android:layout_marginBottom="10dp"/>

            <Spinner
                android:id="@+id/spinnerYakit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_modern_kutu"
                android:layout_marginBottom="10dp"/>
            <Spinner
                android:id="@+id/spinnerVites"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_modern_kutu"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnRaporAnaKaydet"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Ana Bilgileri Kaydet ve Devam Et"
                android:backgroundTint="@color/ana_yesil"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="15dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>